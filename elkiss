#!/usr/bin/env -S emacs --script
;; -*- mode: emacs-lisp -*-
;; This is a CLI wrapper for the kiss.el library.

(require 'package)
(package-initialize)
(add-to-list 'load-path
             (file-name-directory (or load-file-name buffer-file-name)))
(require 'kiss)

(setq kiss-command      (car argv))
(setq kiss-command-args (cdr argv))

(defun elkiss--print-lines (lines)
  "Write each string in LINES as one machine-readable stdout record."
  (dolist (line lines)
    (princ line)
    (terpri)))

(defun elkiss--print-result (command result)
  "Write COMMAND's portable CLI representation for RESULT to stdout."
  (pcase command
    ("version" (elkiss--print-lines (list kiss-compat-version)))
    ("search" (elkiss--print-lines result))
    ("list"
     (let ((records (if (and (listp result) (stringp (car result)))
                        (list result)
                      result)))
       (dolist (record records)
         (elkiss--print-lines
          (list (format "%s %s"
                        (nth 0 record)
                        (replace-regexp-in-string "[[:space:]]+" "-"
                                                  (nth 1 record))))))))
    ((or "alternatives" "preferred")
     (dolist (record result)
       (elkiss--print-lines (list (string-join (seq-take record 2) " ")))))
    ("remove"
     (dolist (record result)
       (elkiss--print-lines
        (list (if (stringp record) record (string-join record " "))))))
    ("build" nil)
    (_ (when result (elkiss--print-lines (list (format "%s" result)))))))

(defun elkiss--remove (package)
  "Run portable removal preflight for PACKAGE and return (STATUS . RESULT)."
  (cond
   ((not (kiss--pkg-is-installed-p package)) (cons 1 nil))
   ((let ((dependents (kiss--package-get-hard-dependents package)))
      (when dependents
        (cons 1 (mapcar (lambda (name) (concat name "/depends")) dependents)))))
   ((let ((orphans (kiss--package-get-orphan-alternatives package)))
      (when orphans
        (cons 1 (mapcar (lambda (path) (list package path)) orphans)))))
   (t
    (kiss-remove package)
    (cons 0 nil))))

(defun elkiss--invoke (command arguments)
  "Return COMMAND's `(STATUS . RESULT)' under the portable CLI contract."
  (pcase command
    ("remove" (if (= (length arguments) 1)
                  (elkiss--remove (car arguments))
                (cons 1 nil)))
    ("preferred"
     (let ((result (kiss-preferred)))
       (when arguments
         (setq result (seq-filter (lambda (record)
                                    (string= (car record) (car arguments)))
                                  result)))
       (cons (if result 0 1) result)))
    (_
     (let* ((function (and command (intern (concat "kiss-" command))))
            (result (and (fboundp function) (apply function arguments))))
       (if (not (fboundp function))
           (cons 1 nil)
         (cons (if (and (member command '("list" "search")) (null result)) 1 0)
               result))))))

(let ((exit-status 0))
  (unwind-protect
      (condition-case err
          (let* ((kiss-defer-build-cleanup t)
                 (outcome (elkiss--invoke kiss-command kiss-command-args))
                 (status (car outcome))
                 (result (cdr outcome)))
            (if (and (not (fboundp (intern (concat "kiss-" kiss-command))))
                     (not (member kiss-command '("remove" "preferred"))))
                (message "elkiss: unknown command: %s" kiss-command)
              (elkiss--print-result kiss-command result))
            (setq exit-status status))
        (error
         (message "elkiss: %s" (error-message-string err))
         (setq exit-status 1)))
    ;; Upstream invokes global hooks once on process exit.  Keep this cleanup
    ;; outside command dispatch so it also observes unsuccessful commands.
    (unless (string= kiss-command "remove")
      (condition-case err
          (kiss--run-hook "SIGEXIT")
        (error
         (message "elkiss: %s" (error-message-string err))
         (setq exit-status 1)))))
  (when (string-prefix-p (file-name-as-directory kiss-tmpdir)
                          default-directory)
    ;; `default-directory' is the staged package record after a successful
    ;; build.  Its first relative component is the private process workspace.
    (let* ((relative (file-relative-name default-directory kiss-tmpdir))
           (workspace (car (split-string relative "/" t))))
      (when workspace
        (delete-directory (expand-file-name workspace kiss-tmpdir) t))))
  (kill-emacs exit-status))
