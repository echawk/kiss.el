;;; kiss-test-fixture.el --- Isolated KISS test fixture -*- lexical-binding: t; -*-
;;
;; Tests that touch the "system" (installed db, choices db, caches) MUST run
;; against a temporary root, never against /var/db/kiss.  Usage:
;;
;;   (ert-deftest my/test ()
;;     (kiss-test-with-fixture
;;       (kiss-test-make-pkg "foo" "2.0" "3" :depends '("bar")
;;                           :files '(("/usr/bin/foo" . "#!/bin/sh\necho hi")))
;;       (should (kiss--pkg-is-installed-p "foo"))))
;;
;; The macro rebinds the kiss-* path constants to a fresh temp tree and
;; removes it afterwards.  Code that reads the constants at call time sees
;; the fixture.

(defmacro kiss-test-with-fixture (&rest body)
  "Run BODY against a fresh temporary KISS root and cache."
  (declare (indent 0))
  `(let* ((root (concat (file-name-as-directory
                         (make-temp-file "kiss-test-" t nil)) "root/"))
          (cache (concat (file-name-as-directory
                          (make-temp-file "kiss-test-" t nil)) "cache/"))
          (kiss-root root)
          (kiss-installed-db-dir (concat root "var/db/kiss/installed/"))
          (kiss-choices-db-dir (concat root "var/db/kiss/choices/"))
          (kiss-tmpdir (concat cache "proc/"))
          (kiss-srcdir (concat cache "sources/"))
          (kiss-bindir (concat cache "bin/"))
          (kiss-logdir (concat cache "logs/")))
     (unwind-protect
         (progn
           (dolist (d (list kiss-installed-db-dir kiss-choices-db-dir
                            kiss-tmpdir kiss-srcdir kiss-bindir kiss-logdir))
             (make-directory d t))
           ,@body)
       (ignore-errors (kiss--silent-shell-command (format "rm -rf '%s'" (file-name-directory root))))
       (ignore-errors (kiss--silent-shell-command (format "rm -rf '%s'" (file-name-directory cache)))))))

(defun kiss-test-make-pkg (name version release &rest keys)
  "Create installed package NAME VERSION-RELEASE in the fixture db.
Optional KEYS:
  :depends (list)         runtime dependencies
  :make-depends (list)    make dependencies
  :files (alist of root-relative path -> contents; paths ending in \"/\"
           create a directory, others a file)
  :manifest (list)        manifest records to write verbatim; when absent,
                          the manifest is generated by walking the fixture
                          root like the build pipeline does.
Returns the package db directory."
  (let ((pkgdir (concat kiss-installed-db-dir name)))
    (make-directory pkgdir t)
    (kiss--write-text (concat version " " release) 'utf-8 (concat pkgdir "/version"))
    ;; build file: present & executable, as spec 4.1 requires for `list`.
    (let ((b (concat pkgdir "/build")))
      (kiss--write-text "#!/bin/sh -e\n" 'utf-8 b)
      (kiss--silent-shell-command (format "chmod +x '%s'" b)))
    (let* ((deps (plist-get keys :depends))
           (mdeps (plist-get keys :make-depends)))
      (when (or deps mdeps)
        (kiss--write-text
         (concat (string-join
                  (sort (append (or deps '())
                                (mapcar (lambda (s) (concat s " make"))
                                        (or mdeps '())))
                        #'string<)
                  "\n")
                 "\n")
         'utf-8 (concat pkgdir "/depends"))))
    (dolist (pair (plist-get keys :files))
      (let* ((rel (car pair))
             (contents (cdr pair))
             (full (concat kiss-root (unless (string-prefix-p "/" rel) "/") rel)))
        (if (string-suffix-p "/" rel)
            (make-directory full t)
          (progn
            (make-directory (file-name-directory full) t)
            (kiss--write-text contents 'utf-8 full)))))
    (let ((manifest (plist-get keys :manifest)))
      (when (null manifest)
        (setq manifest (kiss--get-manifest-for-dir kiss-root)))
      (kiss--write-text (kiss--manifest-to-string manifest) 'utf-8
                        (concat pkgdir "/manifest")))
    pkgdir))

;; --- differential conformance harness -------------------------------------
;; The reference implementation (/tmp/kiss/kiss) is POSIX and honors
;; KISS_ROOT/KISS_PATH/KISS_PROMPT, so we can run BOTH implementations
;; against identical isolated fixtures and compare their standard output.

(defcustom kiss-test-reference-kiss "/tmp/kiss/kiss"
  "Path to the reference kiss shell script."
  :type 'string)

(defun kiss-test-ref-run (root cache repo-pkg-name &rest args)
  "Run the reference KISS against an isolated ROOT/CACHE.
REPO-PKG-NAME is the recipe directory name (the reference needs KISS_PATH to
point at a repo).  ARGS are the command arguments.  Returns (EXIT . STDOUT)."
  (let ((repo (concat root "repo/")))
    (make-directory repo t)
    (make-directory (concat repo REPO-PKG-NAME) t)
    (let ((proc-buf (generate-new-buffer " *kiss-test-ref*")))
      (unwind-protect
          (let ((proc
                 (start-process
                  "kiss-test-ref" proc-buf
                  "env"
                  "KISS_ROOT=" root
                  "KISS_PATH=" repo
                  "KISS_PROMPT=0"
                  "HOME=" (concat root "home")
                  "XDG_CACHE_HOME=" cache
                  "/bin/sh" kiss-test-reference-kiss
                  (mapconcat #'identity args " "))))
            (while (process-live-p proc) (accept-process-output proc 0.1))
            (cons (process-exit-status proc)
                  (with-current-buffer proc-buf (buffer-string))))
        (kill-buffer proc-buf)))))

(provide 'kiss-test-fixture)
